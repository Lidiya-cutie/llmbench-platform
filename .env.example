# .env.example — конфигурация llmbench
#
# Копировать: cp .env.example .env
# Редактировать под свой сервер.

# === ПУТИ ===
LLMBENCH_DIR=/opt/llmbench
HF_CACHE_DIR=/opt/hf-cache
OUT_DIR=/opt/llmbench/out

# === DOCKER-ОБРАЗ ===
VLLM_IMAGE=mlops-triton-vllm:24.12-qwen3

# === ПОРТЫ ===
VLLM_PORT_GPU0=8070
VLLM_PORT_GPU1=8077
DASHBOARD_PORT=8899

# === МОДЕЛИ (served-model-name) ===
SERVED_MODEL_QWEN3=Qwen3-8B
SERVED_MODEL_VL=Qwen2.5-VL-7B-Instruct

# === GPU ===
GPU_COUNT=2
GPU0_MEM_MIB=24564
GPU1_MEM_MIB=24564

# === ПРОКSIDY (для GitLab, OpenRouter) ===
# SOCKS5: 10810, HTTP: 10811
SOCKS_PROXY=socks5h://127.0.0.1:10810
HTTP_PROXY=http://127.0.0.1:10811

# === GitLab ===
GITLAB_URL=https://git.example.com
GITLAB_GROUP=your-group
GITLAB_TOKEN_FILE=/run/secrets/gitlab_token

# === lm-eval-harness ===
LM_EVAL_VERSION=0.4.12
HF_ALLOW_CODE_EVAL=1

# === VLMEvalKit (Vision) ===
VLM_EVAL_VENV=/opt/llmbench/.venv-vlmeval
